# ==============================================================================
# Skill Exchange Backend Environment Configuration
# ==============================================================================

# Server Port
PORT=5000

# Node Environment (development / production)
NODE_ENV=development

# MongoDB Atlas Connection URI
# Replace with your actual MongoDB Atlas cluster connection string:
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/skill_exchange?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/skill_exchange?retryWrites=true&w=majority

# JWT Authentication Secret Key (use a long, randomly generated secret in production)
JWT_SECRET=super_secret_jwt_key_replace_in_production_xyz123

# JWT Token Expiration (e.g., 7d, 24h, 30d)
JWT_EXPIRES_IN=7d

# Allowed Frontend Client URL for CORS
# In local development: http://localhost:3000 or http://localhost:5173
# In production: https://skill-exchange-ukf2.onrender.com
CLIENT_URL=http://localhost:3000
